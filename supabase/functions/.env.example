# Local testing placeholders only. Do not source this into a hosted deployment.
# Hosted Supabase supplies SUPABASE_URL, SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY automatically; do not duplicate them as custom secrets.
# For standalone local runtimes only, obtain local values from the local CLI.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Leave paid-provider keys empty for offline/cache-only work.
# Database pintheory_data.settings.enabled defaults to false for BOTH providers.
# Adding a key does not enable acquisition; enabling SQL settings needs approval.
GOLF_API_KEY=
GPXZ_API_KEY=

# Optional exact browser origin for delete-account only; blank denies browsers.
# golf-data rejects browser Origin requests independently.
CORS_ALLOWED_ORIGIN=
